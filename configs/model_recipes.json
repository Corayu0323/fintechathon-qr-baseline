{
  "schema_version": "model_recipes_v1",
  "models": {
    "ret1_momentum": {
      "implementation": "signal",
      "source_factor": "feature_ret_1d",
      "sign": 1.0,
      "input_transform": "identity"
    },
    "ret1_reversal": {
      "implementation": "signal",
      "source_factor": "feature_ret_1d",
      "sign": -1.0,
      "input_transform": "identity"
    },
    "ridge": {
      "implementation": "qlib_ridge",
      "estimator": "ridge",
      "alpha": 1.0,
      "fit_intercept": true
    },
    "lightgbm": {
      "implementation": "lightgbm",
      "objective": "regression",
      "max_estimators": 500,
      "early_stopping_rounds": 50,
      "early_stopping_metric": "l2",
      "learning_rate": 0.05,
      "num_leaves": 31,
      "min_child_samples": 200,
      "reg_lambda": 1.0,
      "colsample_bytree": 0.9,
      "subsample": 1.0,
      "random_state": 42,
      "verbosity": -1
    }
  }
}
